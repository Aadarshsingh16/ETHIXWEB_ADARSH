# ---- Supabase (create project in Mumbai / ap-south-1) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key          # only used by admin login (server side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key       # SERVER ONLY. Never expose. Never prefix NEXT_PUBLIC_

# ---- Admin access ----
ADMIN_EMAILS=admin@example.com                        # comma-separated allowlist checked on every admin request

# ---- Spam protection ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare dummy key (always passes) for local dev
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # Cloudflare dummy secret for local dev; use real keys in production
IP_HASH_SALT=change-me-to-a-long-random-string        # used to hash IPs before storing

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX              # digits only, with country code; replace with the real business number
